{"abstract":[{"text":"A status bar appears along the upper edge of the screen and displays information about the device’s current state, like the time, cellular carrier, and battery level.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.HIG\/design\/human-interface-guidelines","doc:\/\/com.apple.HIG\/design\/Human-Interface-Guidelines\/components","doc:\/\/com.apple.HIG\/design\/Human-Interface-Guidelines\/system-experiences"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.HIG\/design\/Human-Interface-Guidelines\/status-bars"},"kind":"article","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"availableLanguages":["en-US","zh-CN","ja-JP","ko-KR"],"customMetadata":{"supported-platforms":"ios,ipados"},"images":[{"identifier":"components-status-bars-thumbnail.png","type":"card"}],"role":"article","title":"Status bars"},"primaryContentSections":[{"content":[{"inlineContent":[{"identifier":"components-status-bar-intro.png","type":"image"}],"type":"paragraph"},{"anchor":"Best-practices","level":2,"text":"Best practices","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Obscure content under the status bar.","type":"text"}],"type":"strong"},{"text":" By default, the background of the status bar is transparent, allowing content beneath to show through. This transparency can make it difficult to see information presented in the status bar. If controls are visible behind the status bar, people may attempt to interact with them and be unable to do so. Be sure to keep the status bar readable, and don’t imply that content behind it is interactive. Prefer using a scroll edge effect to place a blurred view behind the status bar. For developer guidance, see ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/SwiftUI\/ScrollEdgeEffectStyle","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/UIKit\/UIScrollEdgeEffect","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Consider temporarily hiding the status bar when displaying full-screen media.","type":"text"}],"type":"strong"},{"text":" A status bar can be distracting when people are paying attention to media. Temporarily hide these elements to provide a more immersive experience. The Photos app, for example, hides the status bar and other interface elements when people browse full-screen photos.","type":"text"}],"type":"paragraph"},{"columns":[{"alignment":"leading","content":[{"inlineContent":[{"identifier":"status-bar-visible.png","metadata":{"abstract":[{"text":"The Photos app with the status bar visible","type":"text"}],"deviceFrame":"iPhone16-top-half"},"type":"image"}],"type":"paragraph"}],"size":1},{"alignment":"leading","content":[{"inlineContent":[{"identifier":"status-bar-hidden.png","metadata":{"abstract":[{"text":"The Photos app with the status bar hidden","type":"text"}],"deviceFrame":"iPhone16-top-half"},"type":"image"}],"type":"paragraph"}],"size":1}],"numberOfColumns":2,"type":"row"},{"inlineContent":[{"inlineContent":[{"text":"Avoid permanently hiding the status bar.","type":"text"}],"type":"strong"},{"text":" Without a status bar, people have to leave your app to check the time or see if they have a Wi-Fi connection. Let people redisplay a hidden status bar with a simple, discoverable gesture. For example, when browsing full-screen photos in the Photos app, a single tap shows the status bar again.","type":"text"}],"type":"paragraph"},{"anchor":"Platform-considerations","level":2,"text":"Platform considerations","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"No additional considerations for iOS or iPadOS. Not supported in macOS, tvOS, visionOS, or watchOS.","type":"text"}],"type":"emphasis"}],"type":"paragraph"},{"anchor":"Resources","level":2,"text":"Resources","type":"heading"},{"anchor":"Developer-documentation","level":4,"text":"Developer documentation","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/com.apple.documentation\/documentation\/UIKit\/UIStatusBarStyle","isActive":true,"type":"reference"},{"text":" — UIKit","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/com.apple.documentation\/documentation\/UIKit\/UIViewController\/preferredStatusBarStyle","isActive":true,"type":"reference"},{"text":" — UIKit","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"topicSectionsStyle":"compactGrid","references":{"components-status-bar-intro.png":{"alt":"A stylized representation of an iPhone status bar with labels showing the time and cellular, Wi-Fi, and battery levels. The image is tinted red to subtly reflect the red in the original six-color Apple logo.","identifier":"components-status-bar-intro.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.HIG\/components-status-bar-intro@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.HIG\/components-status-bar-intro~dark@2x.png"}]},"components-status-bars-thumbnail.png":{"alt":"A stylized representation of an iPhone status bar showing the time and cellular, Wi-Fi, and battery levels. The image is tinted red to subtly reflect the red in the original six-color Apple logo.","identifier":"components-status-bars-thumbnail.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.HIG\/components-status-bars-thumbnail@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.HIG\/components-status-bars-thumbnail~dark@2x.png"}]},"components-system-experiences-thumbnail.png":{"alt":"A stylized representation of an iPad frame over