{
  "productName": "CupertinoCheck",
  "version": "0.1.0",
  "identifier": "dev.cupertino.check",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
