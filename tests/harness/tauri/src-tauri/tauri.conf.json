        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 26 },
        "theme": null,
        "center": true
      }
    ]
  },
  "bundle": {
    "icon": ["icons/icon.png"]
  }
}
