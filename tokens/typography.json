{
 "$meta": {
  "description": "Typography tokens for iOS 27 and macOS 27. Sizes in points (1pt = 1 CSS px = 1 Flutter logical px). trackingEm is letter-spacing in em, already computed from Apple's tracking tables. Always apply tracking: the SF system font does it automatically on Apple platforms, every other font needs it explicitly.",
  "sources": {
   "hig": "HIG Typography specifications (Dynamic Type tables, tracking tables, macOS text styles)",
   "kit": "iOS 27 and macOS 27 UI kit text styles (tight and loose leading)"
  }
 },
 "fontStacks": {
  "$usage": "Pick the stack by target. Never ship SF font files: license allows Apple platforms only. On Apple devices the system font IS SF, so system-ui stacks render real SF legally.",
  "web": "-apple-system, BlinkMacSystemFont, system-ui, 'Inter Variable', 'Inter', 'Segoe UI Variable', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
  "webRounded": "ui-rounded, 'SF Pro Rounded', -apple-system, system-ui, 'Nunito', sans-serif",
  "webSerif": "ui-serif, 'New York', 'Iowan Old Style', Georgia, serif",
  "webMono": "ui-monospace, 'SF Mono', SFMono-Regular, Menlo, 'JetBrains Mono', Consolas, monospace",
  "webBangla": "'Hind Siliguri', 'Noto Sans Bengali', 'Kohinoor Bangla', sans-serif",
  "flutterApple": ".SF Pro Text / .SF Pro Display via CupertinoTheme default (do not set fontFamily on iOS/macOS)",
  "flutterOther": "Inter (bundle Inter variable font, OFL license) with tracking from this file",
  "tauriMac": "-apple-system (WebKit on macOS renders SF)",
  "tauriWindows": "'Inter Variable', 'Segoe UI Variable', sans-serif"
 },
 "fallbackCompensation": {
  "$usage": "When the rendered font is Inter instead of SF (Android, Windows, Linux), Inter runs about 2 to 3 percent wider. Apply these on top of tracking to keep line lengths and wraps identical to SF.",
  "inter": {
   "trackingDeltaEm": -0.01,
   "fontFeatureSettings": "'cv11', 'ss01', 'ss03'",
   "note": "cv11 single storey a off, ss01 open digits, ss03 rounded quotes bring Inter closer to SF. Keep optical sizing on: font-optical-sizing auto."
  }
 },
