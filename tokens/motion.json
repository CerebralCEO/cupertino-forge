      "indicatorStretchWhileDragging": true,
      "interruptible": true,
      "reducedMotion": {
        "strategy": "crossfade",
        "durationMs": 200,
        "bounce": 0,
        "$source": "Apple HIG Accessibility Reduce Motion",
        "$class": "inferred",
        "$url": "https://developer.apple.com/design/human-interface-guidelines/accessibility"
      },
      "$source": "estimated",
      "$class": "estimated",
      "$url": "https://developer.apple.com/design/human-interface-guidelines/motion",
      "$platform": "All"
    },
    "listRowHighlight": {
      "pressInMs": 0,
      "fadeOutMs": 250,
      "interruptible": true,
      "reducedMotion": {
        "strategy": "crossfade",
        "durationMs": 200,
        "bounce": 0,
        "$source": "Apple HIG Accessibility Reduce Motion",
        "$class": "inferred",
        "$url": "https://developer.apple.com/design/human-interface-guidelines/accessibility"
      },
      "$source": "estimated",
      "$class": "estimated",
      "$url": "https://developer.apple.com/design/human-interface-guidelines/motion",
      "$platform": "All"
    },
    "fade": {
      "durationMs": 200,
      "interruptible": true,
      "reducedMotion": {
        "strategy": "crossfade",
        "durationMs": 200,
        "bounce": 0,
        "$source": "Apple HIG Accessibility Reduce Motion",
        "$class": "inferred",
        "$url": "https://developer.apple.com/design/human-interface-guidelines/accessibility"
      },
      "$source": "estimated",
      "$class": "estimated",
      "$url": "https://developer.apple.com/design/human-interface-guidelines/motion",
      "$platform": "All"
    },
    "toast": {
      "from": "top, translateY -20 opacity 0",
      "spring": "snappy",
      "interruptible": true,
      "reducedMotion": {
        "strategy": "crossfade",
        "durationMs": 200,
        "bounce": 0,
        "$source": "Apple HIG Accessibility Reduce Motion",
        "$class": "inferred",
        "$url": "https://developer.apple.com/design/human-interface-guidelines/accessibility"
      },
      "$source": "estimated",
      "$class": "estimated",
      "$url": "https://developer.apple.com/design/human-interface-guidelines/motion",
      "$platform": "All"
    },
    "$class": "estimated",
    "$url": "https://developer.apple.com/documentation/swiftui/navigationtransition",
    "$platform": "All"
  },
  "press": {
    "$usage": "Every tappable thing has a press state. Values per category.",
    "glassButton": {
      "scale": 1.1,
      "highlight": "brighten rim",
      "spring": "press",
      "releaseSpring": "release"
    },
    "solidButton": {
      "scale": 0.97,
      "opacity": 1,
      "overlay": "#000000@0.1 light / #FFFFFF@0.1 dark",
      "spring": "press"
    },
    "plainTextButton": {
      "opacity": 0.35,
      "durationMs": 0,
      "releaseFadeMs": 200
    },
    "listRow": {
      "background": "fillIOS.quaternary on iOS (gray5 light / gray4 dark)",
      "scale": 1
    },
    "card": {
      "scale": 0.98,
      "spring": "press"
    },
    "macOSControl": {
      "scale": 1,
      "fill": "macOSControlFills.contentArea.borderedPressed",
      "durationMs": 0
    },
    "$source": "estimated (HIG Motion touch vs pointer qualitative)",
    "$class": "estimated",
    "$url": "https://developer.apple.com/design/human-interface-guidelines/motion",
    "$platform": "All"
  },
  "hover": {
    "$usage": "Pointer devices only (@media (hover: hover) and (pointer: fine)). Never on touch.",
    "macOSToolbarItem": {
      "background": "fillMacOS.secondary",
      "durationMs": 100
    },
    "macOSListRow": "no hover background except in sidebars and menus",
    "menuItem": {
      "background": "accent",
      "label": "#FFFFFF",
      "durationMs": 0
    },
    "iPadPointer": {
      "lift": 1.04,
      "shadow": "0 6px 16px rgba(0,0,0,0.18)"
    },
    "link": "no underline on hover in app UI",
    "cursor": "default arrow on buttons in macOS style; pointer cursor only for web links",
    "$source": "estimated",
    "$class": "estimated",
    "$url": "https://developer.apple.com/design/human-interface-guidelines/layout",
    "$platform": "macOS / iPadOS / Web"
  },
  "scroll": {
    "decelerationRateNormal": 0.998,
    "decelerationRateFast": 0.99,
    "rubberBand": {
      "formula": "offset = (1 - 1 / ((x * c / d) + 1)) * d",
      "c": 0.55,
      "d": "viewport dimension",
      "$class": "inferred",
      "$source": "inferred reverse-engineered UIScrollView c=0.55"
    },
    "scrollEdgeEffect": "content under bars fades and softly blurs over the top 40 to 60pt instead of a hard bar background",
    "$source": "UIScrollView.DecelerationRate official; rubberBand c=0.55 inferred",
    "$class": "official",
    "$url": "https://developer.apple.com/documentation/uikit/uiscrollview/decelerationrate",
    "$platform": "iOS / iPadOS"
  },
  "reducedMotion": {
    "$usage": "When prefers-reduced-motion or the OS setting is on: replace slides, scales and bounces with 200ms crossfades. Keep spring bounce 0. Disable parallax and glass wobble. Never remove state feedback."
  },
  "symbolEffects": {
    "bounce": "scale 1 to 1.2 to 1 with snappy spring",
    "pulse": "opacity 1 to 0.5 loop 1s",
    "replace": "old symbol scales to 0.6 and fades while new scales from 0.6, 250ms",
    "wiggle": "rotate -8 to 8 deg 3 times",
    "variableColor": "layered opacity cycle",
    "$source": "estimated CSS/SVG timing approximations of SF Symbols animations",
    "$class": "estimated",
    "$url": "https://developer.apple.com/design/human-interface-guidelines/sf-symbols",
    "$platform": "Web / Flutter"
  }
}
