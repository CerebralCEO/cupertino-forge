{
  "$meta": {
    "description": "Icon rules and the SF Symbols mapping. SF Symbols are licensed for Apple platform apps only. On web, Android, Windows use the mapped open icon sets drawn to match SF weight.",
    "sets": {
      "web": "lucide-react (ISC) with strokeWidth from the weight table, or @phosphor-icons/react (MIT) weight regular/bold/fill",
      "flutter": "CupertinoIcons (MIT, ships with Flutter) first, lucide_icons_flutter second",
      "apple-native": "Real SF Symbols through the OS when the target is iOS or macOS native"
    }
  },
  "rules": [
    "Icon weight matches the adjacent text weight. Regular text = regular icon.",
    "Icon size follows the text style: scale small = 0.8 x cap, medium = text size, large = 1.3 x text size.",
    "Lucide strokeWidth by text weight: regular 1.75, medium 2, semibold 2.25, bold 2.5. At 16px and below use 2.",
    "Filled variants for selected state in tab bars and sidebars only (house.fill when selected, house when not). Lucide has no fill: use Phosphor fill weight for those slots.",
    "Monochrome by default. Hierarchical (primary plus 50 percent secondary) for multi layer icons. Multicolor only for status (battery, weather).",
    "Never put icons inside colored circles in list rows unless they are Settings-style app rows (29pt rounded square, radius 7, white glyph on system color).",
    "Never mix icon families in one screen."
  ],
  "weightToLucideStroke": { "ultralight": 1, "thin": 1.25, "light": 1.5, "regular": 1.75, "medium": 2, "semibold": 2.25, "bold": 2.5, "heavy": 2.75, "black": 3 },
